# Copy this file to ".env" and fill in real values.
# .env is git-ignored so your secrets never get committed.

# Flask
FLASK_DEBUG=True

# Used to sign sessions/cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Set to True in production (HTTPS only). Must be False for local http:// dev,
# or the browser will refuse to send the login cookie and you can't log in.
SESSION_COOKIE_SECURE=False

# Optional: override the database. Defaults to a local SQLite file
# in the instance/ folder if left unset.
# DATABASE_URL=sqlite:///familyhub.db

# Optional: where uploaded photos are stored. Defaults to <project>/uploads,
# which is outside the web root and git-ignored.
# UPLOAD_FOLDER=/var/familyhub/uploads

# Rate limiting on the login form (10 tries/minute per IP). Leave on.
# RATELIMIT_ENABLED=True

# Set to True ONLY in production behind nginx, so Flask trusts the
# X-Forwarded-For header for real visitor IPs. False everywhere else.
TRUST_PROXY=False

# --- Backups (production) ---
# Local backup zips default to <project>/backups. For the OFF-SITE copy,
# set the Lightsail bucket name + access keys (from the Lightsail console).
# Leave unset in dev: backups then stay local-only, with a friendly notice.
# BACKUP_S3_BUCKET=familyhub-backups
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1
