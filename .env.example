# Copy this file to ".env" and fill in real values.
# .env is git-ignored so your secrets never get committed.

# Flask
FLASK_DEBUG=True

# Used to sign sessions/cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Set to True in production (HTTPS only). Must be False for local http:// dev,
# or the browser will refuse to send the login cookie and you can't log in.
SESSION_COOKIE_SECURE=False

# Optional: override the database. Defaults to a local SQLite file
# in the instance/ folder if left unset.
# DATABASE_URL=sqlite:///familyhub.db

# Optional: where uploaded photos are stored. Defaults to <project>/uploads,
# which is outside the web root and git-ignored.
# UPLOAD_FOLDER=/var/familyhub/uploads
