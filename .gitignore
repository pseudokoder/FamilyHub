# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
/out-tsc

# dependencies
/node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Python
.venv/
__pycache__/
*.pyc

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
.env
instance/
# Uploaded family photos live outside the web root and outside git.
# They are real family data — backups handle them, not version control.
uploads/
# Backup zips and data exports — generated artifacts, often large.
backups/
export/
/.sass-cache
/connect.lock
/coverage
# pytest-cov's data file + HTML report — regenerated on every run, never
# committed (it churns constantly and is meaningless in history).
.coverage
htmlcov/
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db
